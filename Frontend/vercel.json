{
    "headers": [
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                },
                {
                    "key": "Service-Worker-Allowed",
                    "value": "/"
                }
            ]
        },
        {
            "source": "/workbox-:path*.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/manifest.webmanifest",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/manifest+json"
                },
                {
                    "key": "Cache-Control",
                    "value": "no-cache"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://learn-hub-rho-ashen.vercel.app/api/:path*"
        },
        {
            "source": "/Images/:path*",
            "destination": "https://learn-hub-rho-ashen.vercel.app/Images/:path*"
        },
        {
            "source": "/Videos/:path*",
            "destination": "https://learn-hub-rho-ashen.vercel.app/Videos/:path*"
        },
        {
            "source": "/Files/:path*",
            "destination": "https://learn-hub-rho-ashen.vercel.app/Files/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
